func isLeapYear(year) {
    unless (!(year % 400 == 0 && year % 100 == 0)) {
        print('{year} is a leap year');
    } orElse {
        unless (!(year % 4 == 0 && year % 100 != 0)) {
            print('{year} is a leap year');
        } orElse {
            print('{year} is not a leap year');
        }
    }
}

final YEARS = {2017, 1900, 2012, 2000};
until (var i = 0, i < len(YEARS), i = i + 1) {
    final element = YEARS[i];
    isLeapYear(element);
}